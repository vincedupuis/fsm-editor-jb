<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:umldi="http://www.omg.org/spec/UML/20161101/UMLDI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <uml:Model xmi:id="sm_model" name="MediaPlayer">
    <packagedElement xmi:type="uml:Class" xmi:id="sm_context" name="MediaPlayer" classifierBehavior="sm">
      <ownedBehavior xmi:type="uml:StateMachine" xmi:id="sm" name="MediaPlayer">
        <ownedComment xmi:type="uml:Comment" xmi:id="sm_doc" annotatedElement="sm">
          <body>Example UML state machine: composite and orthogonal states, deep history, choice, exit point and an internal transition.</body>
        </ownedComment>
        <region xmi:type="uml:Region" xmi:id="r_root">
          <ownedComment xmi:type="uml:Comment" xmi:id="v_note" annotatedElement="v_hist">
            <body>Deep history restores the
last active playback substates
after a fault is reset.</body>
          </ownedComment>
          <subvertex xmi:type="uml:Pseudostate" xmi:id="v_init" kind="initial"/>
          <subvertex xmi:type="uml:State" xmi:id="v_off" name="Off">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="v_off_entry">
              <language>FSM</language>
              <body>powerDown()</body>
            </entry>
          </subvertex>
          <subvertex xmi:type="uml:FinalState" xmi:id="v_final"/>
          <subvertex xmi:type="uml:State" xmi:id="v_on" name="On">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="v_on_entry">
              <language>FSM</language>
              <body>ampOn()</body>
            </entry>
            <exit xmi:type="uml:OpaqueBehavior" xmi:id="v_on_exit">
              <language>FSM</language>
              <body>ampOff()</body>
            </exit>
            <connectionPoint xmi:type="uml:Pseudostate" xmi:id="v_fault_xp" name="fault" kind="exitPoint"/>
            <region xmi:type="uml:Region" xmi:id="r_on">
              <subvertex xmi:type="uml:Pseudostate" xmi:id="v_on_init" kind="initial"/>
              <subvertex xmi:type="uml:Pseudostate" xmi:id="v_hist" kind="deepHistory"/>
              <subvertex xmi:type="uml:State" xmi:id="v_stopped" name="Stopped">
                <entry xmi:type="uml:OpaqueBehavior" xmi:id="v_stopped_entry">
                  <language>FSM</language>
                  <body>rewind()</body>
                </entry>
              </subvertex>
              <subvertex xmi:type="uml:State" xmi:id="v_paused" name="Paused">
                <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="v_paused_do">
                  <language>FSM</language>
                  <body>blinkLed()</body>
                </doActivity>
              </subvertex>
              <subvertex xmi:type="uml:Pseudostate" xmi:id="v_choice" kind="choice"/>
              <subvertex xmi:type="uml:State" xmi:id="v_playing" name="Playing">
                <region xmi:type="uml:Region" xmi:id="r_audio" name="audio">
                  <subvertex xmi:type="uml:Pseudostate" xmi:id="v_ai" kind="initial"/>
                  <subvertex xmi:type="uml:State" xmi:id="v_stereo" name="Stereo"/>
                  <subvertex xmi:type="uml:State" xmi:id="v_mono" name="Mono"/>
                  <transition xmi:type="uml:Transition" xmi:id="t16" kind="external" source="v_ai" target="v_stereo"/>
                  <transition xmi:type="uml:Transition" xmi:id="t17" kind="external" source="v_stereo" target="v_mono">
                    <trigger xmi:type="uml:Trigger" xmi:id="t17_trigger1" name="toggleAudio" event="ev_toggleAudio"/>
                  </transition>
                  <transition xmi:type="uml:Transition" xmi:id="t18" kind="external" source="v_mono" target="v_stereo">
                    <trigger xmi:type="uml:Trigger" xmi:id="t18_trigger1" name="toggleAudio" event="ev_toggleAudio"/>
                  </transition>
                </region>
                <region xmi:type="uml:Region" xmi:id="r_video" name="video">
                  <subvertex xmi:type="uml:Pseudostate" xmi:id="v_vi" kind="initial"/>
                  <subvertex xmi:type="uml:State" xmi:id="v_hd" name="HD"/>
                  <subvertex xmi:type="uml:State" xmi:id="v_sd" name="SD"/>
                  <transition xmi:type="uml:Transition" xmi:id="t19" kind="external" source="v_vi" target="v_hd"/>
                  <transition xmi:type="uml:Transition" xmi:id="t20" kind="external" source="v_hd" target="v_sd">
                    <trigger xmi:type="uml:Trigger" xmi:id="t20_trigger1" name="lowBandwidth" event="ev_lowBandwidth"/>
                  </transition>
                  <transition xmi:type="uml:Transition" xmi:id="t21" kind="external" source="v_sd" target="v_hd">
                    <trigger xmi:type="uml:Trigger" xmi:id="t21_trigger1" name="highBandwidth" event="ev_highBandwidth"/>
                  </transition>
                </region>
              </subvertex>
              <transition xmi:type="uml:Transition" xmi:id="t5" kind="external" source="v_on_init" target="v_stopped"/>
              <transition xmi:type="uml:Transition" xmi:id="t6" kind="external" source="v_hist" target="v_stopped"/>
              <transition xmi:type="uml:Transition" xmi:id="t7" kind="external" source="v_stopped" target="v_playing">
                <trigger xmi:type="uml:Trigger" xmi:id="t7_trigger1" name="play" event="ev_play"/>
              </transition>
              <transition xmi:type="uml:Transition" xmi:id="t8" kind="external" source="v_playing" target="v_paused">
                <trigger xmi:type="uml:Trigger" xmi:id="t8_trigger1" name="pause" event="ev_pause"/>
              </transition>
              <transition xmi:type="uml:Transition" xmi:id="t9" kind="external" source="v_paused" target="v_playing">
                <trigger xmi:type="uml:Trigger" xmi:id="t9_trigger1" name="play" event="ev_play"/>
              </transition>
              <transition xmi:type="uml:Transition" xmi:id="t10" kind="external" source="v_paused" target="v_stopped">
                <trigger xmi:type="uml:Trigger" xmi:id="t10_trigger1" name="stop" event="ev_stop"/>
              </transition>
              <transition xmi:type="uml:Transition" xmi:id="t11" kind="external" source="v_stopped" target="v_choice">
                <trigger xmi:type="uml:Trigger" xmi:id="t11_trigger1" name="eject" event="ev_eject"/>
              </transition>
              <transition xmi:type="uml:Transition" xmi:id="t12" kind="external" source="v_choice" target="v_stopped">
                <guard xmi:type="uml:Constraint" xmi:id="t12_guard">
                  <specification xmi:type="uml:OpaqueExpression" xmi:id="t12_guard_spec">
                    <language>FSM</language>
                    <body>else</body>
                  </specification>
                </guard>
                <effect xmi:type="uml:OpaqueBehavior" xmi:id="t12_effect">
                  <language>FSM</language>
                  <body>openTray()</body>
                </effect>
              </transition>
              <transition xmi:type="uml:Transition" xmi:id="t22" kind="internal" source="v_paused" target="v_paused">
                <trigger xmi:type="uml:Trigger" xmi:id="t22_trigger1" name="volumeChanged" event="ev_volumeChanged"/>
                <effect xmi:type="uml:OpaqueBehavior" xmi:id="t22_effect">
                  <language>FSM</language>
                  <body>updateVolume()</body>
                </effect>
              </transition>
              <transition xmi:type="uml:Transition" xmi:id="t23" kind="external" source="v_paused" target="v_stopped">
                <trigger xmi:type="uml:Trigger" xmi:id="t23_trigger1" name="after(5m)" event="ev_after_5m_"/>
                <effect xmi:type="uml:OpaqueBehavior" xmi:id="t23_effect">
                  <language>FSM</language>
                  <body>saveBookmark()</body>
                </effect>
              </transition>
            </region>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="v_fault" name="Fault">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="v_fault_entry">
              <language>FSM</language>
              <body>showError()</body>
            </entry>
          </subvertex>
          <transition xmi:type="uml:Transition" xmi:id="t1" kind="external" source="v_init" target="v_off"/>
          <transition xmi:type="uml:Transition" xmi:id="t2" kind="external" source="v_off" target="v_on">
            <trigger xmi:type="uml:Trigger" xmi:id="t2_trigger1" name="powerOn" event="ev_powerOn"/>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="t3" kind="external" source="v_on" target="v_off">
            <trigger xmi:type="uml:Trigger" xmi:id="t3_trigger1" name="powerOff" event="ev_powerOff"/>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="t4" kind="external" source="v_off" target="v_final">
            <trigger xmi:type="uml:Trigger" xmi:id="t4_trigger1" name="unplug" event="ev_unplug"/>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="t13" kind="external" source="v_choice" target="v_fault_xp">
            <guard xmi:type="uml:Constraint" xmi:id="t13_guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="t13_guard_spec">
                <language>FSM</language>
                <body>isTrayJammed()</body>
              </specification>
            </guard>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="t14" kind="external" source="v_fault_xp" target="v_fault"/>
          <transition xmi:type="uml:Transition" xmi:id="t15" kind="external" source="v_fault" target="v_hist">
            <trigger xmi:type="uml:Trigger" xmi:id="t15_trigger1" name="reset" event="ev_reset"/>
          </transition>
        </region>
      </ownedBehavior>
    </packagedElement>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_toggleAudio" name="toggleAudio" signal="sig_toggleAudio"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_toggleAudio" name="toggleAudio"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_lowBandwidth" name="lowBandwidth" signal="sig_lowBandwidth"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_lowBandwidth" name="lowBandwidth"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_highBandwidth" name="highBandwidth" signal="sig_highBandwidth"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_highBandwidth" name="highBandwidth"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_play" name="play" signal="sig_play"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_play" name="play"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_pause" name="pause" signal="sig_pause"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_pause" name="pause"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_stop" name="stop" signal="sig_stop"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_stop" name="stop"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_eject" name="eject" signal="sig_eject"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_eject" name="eject"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_volumeChanged" name="volumeChanged" signal="sig_volumeChanged"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_volumeChanged" name="volumeChanged"/>
    <packagedElement xmi:type="uml:TimeEvent" xmi:id="ev_after_5m_" name="after(5m)" isRelative="true">
      <when xmi:type="uml:TimeExpression" xmi:id="ev_after_5m__when">
        <expr xmi:type="uml:LiteralString" xmi:id="ev_after_5m__expr" value="5m"/>
      </when>
    </packagedElement>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_powerOn" name="powerOn" signal="sig_powerOn"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_powerOn" name="powerOn"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_powerOff" name="powerOff" signal="sig_powerOff"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_powerOff" name="powerOff"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_unplug" name="unplug" signal="sig_unplug"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_unplug" name="unplug"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_reset" name="reset" signal="sig_reset"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_reset" name="reset"/>
  </uml:Model>
  <umldi:UMLStateMachineDiagram xmi:id="sm_diagram" name="MediaPlayer" modelElement="sm" isFrame="false">
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_note" modelElement="v_note">
      <bounds xmi:type="dc:Bounds" x="30" y="480" width="210" height="64"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_init" modelElement="v_init">
      <bounds xmi:type="dc:Bounds" x="40" y="100" width="20" height="20"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_off" modelElement="v_off">
      <bounds xmi:type="dc:Bounds" x="100" y="80" width="150" height="60"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_final" modelElement="v_final">
      <bounds xmi:type="dc:Bounds" x="162" y="260" width="26" height="26"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_on" modelElement="v_on">
      <bounds xmi:type="dc:Bounds" x="340" y="20" width="780" height="500"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_r_on" modelElement="r_on">
      <bounds xmi:type="dc:Bounds" x="340" y="78" width="780" height="442"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_fault_xp" modelElement="v_fault_xp">
