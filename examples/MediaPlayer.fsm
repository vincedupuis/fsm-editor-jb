    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_mono" modelElement="v_mono">
      <bounds xmi:type="dc:Bounds" x="965" y="145" width="100" height="50"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_vi" modelElement="v_vi">
      <bounds xmi:type="dc:Bounds" x="780" y="265" width="20" height="20"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_hd" modelElement="v_hd">
      <bounds xmi:type="dc:Bounds" x="825" y="250" width="100" height="50"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_sd" modelElement="v_sd">
      <bounds xmi:type="dc:Bounds" x="965" y="250" width="100" height="50"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_fault" modelElement="v_fault">
