    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_choice" modelElement="v_choice">
      <bounds xmi:type="dc:Bounds" x="461" y="300" width="28" height="28"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_playing" modelElement="v_playing">
      <bounds xmi:type="dc:Bounds" x="760" y="96" width="330" height="230"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_r_audio" modelElement="r_audio">
      <bounds xmi:type="dc:Bounds" x="760" y="120" width="330" height="103"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_r_video" modelElement="r_video">
      <bounds xmi:type="dc:Bounds" x="760" y="223" width="330" height="103"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_ai" modelElement="v_ai">
      <bounds xmi:type="dc:Bounds" x="780" y="160" width="20" height="20"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_v_stereo" modelElement="v_stereo">
