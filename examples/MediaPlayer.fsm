    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t16" modelElement="t16" source="di_v_ai" target="di_v_stereo">
      <waypoint xmi:type="dc:Point" x="790" y="170"/>
      <waypoint xmi:type="dc:Point" x="875" y="170"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t17" modelElement="t17" source="di_v_stereo" target="di_v_mono">
      <waypoint xmi:type="dc:Point" x="875" y="170"/>
      <waypoint xmi:type="dc:Point" x="1015" y="170"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t18" modelElement="t18" source="di_v_mono" target="di_v_stereo">
      <waypoint xmi:type="dc:Point" x="1015" y="170"/>
      <waypoint xmi:type="dc:Point" x="945" y="210"/>
      <waypoint xmi:type="dc:Point" x="875" y="170"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t19" modelElement="t19" source="di_v_vi" target="di_v_hd">
      <waypoint xmi:type="dc:Point" x="790" y="275"/>
      <waypoint xmi:type="dc:Point" x="875" y="275"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t20" modelElement="t20" source="di_v_hd" target="di_v_sd">
      <waypoint xmi:type="dc:Point" x="875" y="275"/>
      <waypoint xmi:type="dc:Point" x="1015" y="275"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t21" modelElement="t21" source="di_v_sd" target="di_v_hd">
      <waypoint xmi:type="dc:Point" x="1015" y="275"/>
      <waypoint xmi:type="dc:Point" x="945" y="313"/>
      <waypoint xmi:type="dc:Point" x="875" y="275"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t5" modelElement="t5" source="di_v_on_init" target="di_v_stopped">
      <waypoint xmi:type="dc:Point" x="365" y="148"/>
      <waypoint xmi:type="dc:Point" x="475" y="148"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t6" modelElement="t6" source="di_v_hist" target="di_v_stopped">
      <waypoint xmi:type="dc:Point" x="368" y="413"/>
      <waypoint xmi:type="dc:Point" x="368" y="165"/>
      <waypoint xmi:type="dc:Point" x="475" y="148"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t7" modelElement="t7" source="di_v_stopped" target="di_v_playing">
      <waypoint xmi:type="dc:Point" x="475" y="148"/>
      <waypoint xmi:type="dc:Point" x="925" y="211"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t8" modelElement="t8" source="di_v_playing" target="di_v_paused">
      <waypoint xmi:type="dc:Point" x="925" y="211"/>
      <waypoint xmi:type="dc:Point" x="870" y="380"/>
      <waypoint xmi:type="dc:Point" x="700" y="395"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t9" modelElement="t9" source="di_v_paused" target="di_v_playing">
      <waypoint xmi:type="dc:Point" x="700" y="395"/>
      <waypoint xmi:type="dc:Point" x="925" y="211"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t10" modelElement="t10" source="di_v_paused" target="di_v_stopped">
      <waypoint xmi:type="dc:Point" x="700" y="395"/>
      <waypoint xmi:type="dc:Point" x="475" y="148"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t11" modelElement="t11" source="di_v_stopped" target="di_v_choice">
      <waypoint xmi:type="dc:Point" x="475" y="148"/>
      <waypoint xmi:type="dc:Point" x="475" y="314"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t12" modelElement="t12" source="di_v_choice" target="di_v_stopped">
      <waypoint xmi:type="dc:Point" x="475" y="314"/>
      <waypoint xmi:type="dc:Point" x="430" y="314"/>
      <waypoint xmi:type="dc:Point" x="430" y="190"/>
      <waypoint xmi:type="dc:Point" x="475" y="148"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t23" modelElement="t23" source="di_v_paused" target="di_v_stopped">
      <waypoint xmi:type="dc:Point" x="700" y="395"/>
      <waypoint xmi:type="dc:Point" x="700" y="250"/>
      <waypoint xmi:type="dc:Point" x="475" y="148"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t1" modelElement="t1" source="di_v_init" target="di_v_off">
      <waypoint xmi:type="dc:Point" x="50" y="110"/>
      <waypoint xmi:type="dc:Point" x="175" y="110"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t2" modelElement="t2" source="di_v_off" target="di_v_on">
      <waypoint xmi:type="dc:Point" x="175" y="110"/>
      <waypoint xmi:type="dc:Point" x="300" y="95"/>
      <waypoint xmi:type="dc:Point" x="730" y="270"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t3" modelElement="t3" source="di_v_on" target="di_v_off">
      <waypoint xmi:type="dc:Point" x="730" y="270"/>
