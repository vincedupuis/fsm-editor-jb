<idea-plugin>
    <id>com.vincegosoftware.fsmeditor</id>
    <name>FSM Editor - UML State Machines &amp; Code Generation</name>
    <vendor url="https://github.com/vincedupuis/fsm-editor-jb">VinceGoSoftware</vendor>

    <description><![CDATA[
    <p>Visual editor and <b>code generator</b> for <b>UML 2.5.1 state machines</b> in IntelliJ IDEA and the other JetBrains IDEs.</p>
    <ul>
      <li><b>Code generation</b>: turn a machine into source code with Jinja templates. TypeScript and C++
          (Boost.SML) templates are bundled, and templates for other languages can write several files per machine. The bundled <code>fsm</code>
          generator also runs from a terminal or a build, so the IDE and CI produce the same code.</li>
      <li>Composite, orthogonal and submachine states, all pseudostates, connection point references,
          entry/exit/do behaviors, deferrable events, time triggers and protocol state machines.</li>
      <li>A diagram with a toolbox and a properties panel; the model's JSON stays one click away in the Text tab, checked against its schema.</li>
      <li>Live validation of the UML well-formedness rules, on the diagram and in the Problems tool window.</li>
      <li>Diagram diff and merge: compare a machine with its version in Git, and resolve merge conflicts, as diagrams side by side.</li>
      <li>SVG and PNG export.</li>
    </ul>
    <p>A machine is two JSON files: <code>Name.fsm</code>, the model, readable and editable by hand (elements are identified
    by their names), and <code>Name.fsm.layout</code> beside it, the drawing. They are the same files as in FSM Editor for
    VS Code and for Visual Studio, and diagram elements can be copied and pasted between the three editors. Files of
    earlier versions (XMI) still open, and are converted when changed.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.modules.json</depends>
    <!-- The merge of a file with conflicts (AbstractVcsHelper): a plugin of its own since 2025.3. -->
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="FSM State Machine" implementationClass="com.vincegosoftware.fsmeditor.FsmFileType"
                  fieldName="INSTANCE" language="JSON" extensions="fsm"/>
        <!-- Files of earlier versions (XMI), told apart by their content. -->
        <fileType name="FSM State Machine (XMI)" implementationClass="com.vincegosoftware.fsmeditor.OldFsmFileType"
                  fieldName="INSTANCE" language="FSM"/>
        <!-- The layout file beside a model file. -->
        <fileType name="JSON" patterns="*.fsm.layout"/>
        <lang.parserDefinition language="FSM" implementationClass="com.vincegosoftware.fsmeditor.FsmParserDefinition"/>
        <fileEditorProvider implementation="com.vincegosoftware.fsmeditor.editor.FsmEditorProvider"/>
        <postStartupActivity implementation="com.vincegosoftware.fsmeditor.services.CommonStarter"/>
        <standardResourceProvider implementation="com.vincegosoftware.fsmeditor.services.FsmResources"/>
        <externalAnnotator language="JSON" implementationClass="com.vincegosoftware.fsmeditor.services.FsmAnnotator"/>
        <externalAnnotator language="XML" implementationClass="com.vincegosoftware.fsmeditor.services.FsmAnnotator"/>
        <diff.DiffTool implementation="com.vincegosoftware.fsmeditor.editor.DiagramDiffTool"/>
        <applicationConfigurable parentId="tools" id="fsmEditor" displayName="FSM Editor"
                                 instance="com.vincegosoftware.fsmeditor.settings.FsmConfigurable"/>
        <notificationGroup id="FSM Editor" displayType="BALLOON"/>
        <toolWindow id="Trace Player" anchor="bottom" icon="/icons/trace.svg"
                    factoryClass="com.vincegosoftware.fsmeditor.trace.TracePlayerToolWindowFactory"/>
        <toolWindow id="FSM Code Generation" anchor="bottom" icon="/icons/fsm.svg" canCloseContents="false"
                    factoryClass="com.vincegosoftware.fsmeditor.codegen.CodeGenToolWindowFactory"/>
    </extensions>

    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory implementation="com.vincegosoftware.fsmeditor.services.FsmSchemas"/>
    </extensions>

    <actions>
        <action id="FsmEditor.NewStateMachine" class="com.vincegosoftware.fsmeditor.NewStateMachineAction"
                text="State Machine" description="Create a UML state machine (.fsm)" icon="/icons/fsm.svg">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
        <action id="FsmEditor.GenerateCode" class="com.vincegosoftware.fsmeditor.GenerateCodeAction"
                text="Generate Code..." description="Generate source code from the state machine with a Jinja template"/>
        <action id="FsmEditor.ExportSvg" class="com.vincegosoftware.fsmeditor.ExportSvgAction"
                text="Export as SVG..." description="Save the state machine diagram as an SVG image"/>
        <action id="FsmEditor.ExportPng" class="com.vincegosoftware.fsmeditor.ExportPngAction"
                text="Export as PNG..." description="Save the open state machine diagram as a PNG image"/>
        <action id="FsmEditor.OpenAsText" class="com.vincegosoftware.fsmeditor.OpenAsTextAction"
                text="Open as Text" description="Show the text of the state machine's model file"/>
        <action id="FsmEditor.CompareAsDiagrams" class="com.vincegosoftware.fsmeditor.CompareAsDiagramsAction"
                text="Compare as Diagrams" description="Compare the state machine with its version in Git, as diagrams side by side"/>
        <action id="FsmEditor.OpenInDiagram" class="com.vincegosoftware.fsmeditor.OpenInDiagramAction"
                text="Open in FSM Editor" description="Show the state machine diagram"/>

        <action id="FsmEditor.OpenTrace" class="com.vincegosoftware.fsmeditor.OpenTraceAction"
                text="Open Trace..." description="Replay logs of your state machines on their diagrams in the Trace Player"/>

        <group id="FsmEditor.FileActions">
            <separator/>
            <reference ref="FsmEditor.GenerateCode"/>
            <reference ref="FsmEditor.ExportSvg"/>
            <reference ref="FsmEditor.ExportPng"/>
            <reference ref="FsmEditor.OpenAsText"/>
            <reference ref="FsmEditor.OpenInDiagram"/>
            <reference ref="FsmEditor.CompareAsDiagrams"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </group>

        <group id="FsmEditor.ToolsMenu" text="FSM Editor" popup="true">
            <action id="FsmEditor.NewStateMachineInFolder" class="com.vincegosoftware.fsmeditor.NewStateMachineAction"
                    text="New State Machine..." description="Create a UML state machine (.fsm)"/>
            <reference ref="FsmEditor.GenerateCode"/>
            <reference ref="FsmEditor.ExportSvg"/>
            <reference ref="FsmEditor.ExportPng"/>
            <reference ref="FsmEditor.OpenAsText"/>
            <reference ref="FsmEditor.OpenInDiagram"/>
            <reference ref="FsmEditor.CompareAsDiagrams"/>
            <separator/>
            <reference ref="FsmEditor.OpenTrace"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
