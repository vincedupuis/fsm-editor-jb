<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:umldi="http://www.omg.org/spec/UML/20161101/UMLDI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <uml:Model xmi:id="sm_model" name="Colors">
    <packagedElement xmi:type="uml:StateMachine" xmi:id="sm" name="Colors">
      <region xmi:type="uml:Region" xmi:id="r_root">
        <ownedComment xmi:type="uml:Comment" xmi:id="note" annotatedElement="a">
          <body>Colored note</body>
        </ownedComment>
        <subvertex xmi:type="uml:Pseudostate" xmi:id="init" kind="initial"/>
        <subvertex xmi:type="uml:State" xmi:id="a" name="A">
          <entry xmi:type="uml:OpaqueBehavior" xmi:id="a_entry">
            <language>FSM</language>
            <body>start()</body>
          </entry>
          <exit xmi:type="uml:OpaqueBehavior" xmi:id="a_exit">
            <language>FSM</language>
            <body>stop()</body>
          </exit>
          <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="a_do">
            <language>FSM</language>
            <body>poll()</body>
          </doActivity>
          <stateInvariant xmi:type="uml:Constraint" xmi:id="a_inv">
            <specification xmi:type="uml:OpaqueExpression" xmi:id="a_inv_spec">
              <language>FSM</language>
              <body>isOk()</body>
            </specification>
          </stateInvariant>
          <deferrableTrigger xmi:type="uml:Trigger" xmi:id="a_deferrableTrigger1" name="evD" event="ev_evD"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="b" name="B"/>
        <subvertex xmi:type="uml:Pseudostate" xmi:id="ch" kind="choice"/>
        <transition xmi:type="uml:Transition" xmi:id="t1" kind="external" source="init" target="a"/>
        <transition xmi:type="uml:Transition" xmi:id="t2" kind="external" source="a" target="b">
          <trigger xmi:type="uml:Trigger" xmi:id="t2_trigger1" name="go" event="ev_go"/>
          <guard xmi:type="uml:Constraint" xmi:id="t2_guard">
            <specification xmi:type="uml:OpaqueExpression" xmi:id="t2_guard_spec">
              <language>FSM</language>
              <body>canGo()</body>
            </specification>
          </guard>
          <effect xmi:type="uml:OpaqueBehavior" xmi:id="t2_effect">
            <language>FSM</language>
            <body>log()</body>
          </effect>
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="t3" kind="internal" source="a" target="a">
          <trigger xmi:type="uml:Trigger" xmi:id="t3_trigger1" name="tick" event="ev_tick"/>
          <effect xmi:type="uml:OpaqueBehavior" xmi:id="t3_effect">
            <language>FSM</language>
            <body>count()</body>
          </effect>
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="t4" kind="external" source="b" target="ch">
          <trigger xmi:type="uml:Trigger" xmi:id="t4_trigger1" name="check" event="ev_check"/>
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="t5" kind="external" source="ch" target="a">
          <guard xmi:type="uml:Constraint" xmi:id="t5_guard">
            <specification xmi:type="uml:OpaqueExpression" xmi:id="t5_guard_spec">
              <language>FSM</language>
              <body>else</body>
            </specification>
          </guard>
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="t6" kind="external" source="ch" target="b">
          <guard xmi:type="uml:Constraint" xmi:id="t6_guard">
            <specification xmi:type="uml:OpaqueExpression" xmi:id="t6_guard_spec">
              <language>FSM</language>
              <body>isB()</body>
            </specification>
          </guard>
        </transition>
      </region>
    </packagedElement>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_evD" name="evD" signal="sig_evD"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_evD" name="evD"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_go" name="go" signal="sig_go"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_go" name="go"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_tick" name="tick" signal="sig_tick"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_tick" name="tick"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_check" name="check" signal="sig_check"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_check" name="check"/>
  </uml:Model>
  <umldi:UMLStateMachineDiagram xmi:id="sm_diagram" name="Colors" modelElement="sm" isFrame="false">
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_note" modelElement="note">
      <bounds xmi:type="dc:Bounds" x="120" y="200" width="160" height="64"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_init" modelElement="init">
      <bounds xmi:type="dc:Bounds" x="40" y="60" width="20" height="20"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_a" modelElement="a">
      <bounds xmi:type="dc:Bounds" x="120" y="40" width="180" height="100"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_b" modelElement="b">
      <bounds xmi:type="dc:Bounds" x="400" y="40" width="140" height="60"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLShape" xmi:id="di_ch" modelElement="ch">
      <bounds xmi:type="dc:Bounds" x="456" y="160" width="28" height="28"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t1" modelElement="t1" source="di_init" target="di_a">
      <waypoint xmi:type="dc:Point" x="50" y="70"/>
      <waypoint xmi:type="dc:Point" x="210" y="90"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t2" modelElement="t2" source="di_a" target="di_b">
      <waypoint xmi:type="dc:Point" x="210" y="90"/>
      <waypoint xmi:type="dc:Point" x="470" y="70"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t4" modelElement="t4" source="di_b" target="di_ch">
      <waypoint xmi:type="dc:Point" x="470" y="70"/>
      <waypoint xmi:type="dc:Point" x="470" y="174"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t5" modelElement="t5" source="di_ch" target="di_a">
      <waypoint xmi:type="dc:Point" x="470" y="174"/>
      <waypoint xmi:type="dc:Point" x="210" y="90"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_t6" modelElement="t6" source="di_ch" target="di_b">
      <waypoint xmi:type="dc:Point" x="470" y="174"/>
      <waypoint xmi:type="dc:Point" x="470" y="70"/>
    </ownedElement>
    <ownedElement xmi:type="umldi:UMLEdge" xmi:id="di_note_anchor1" modelElement="note" source="di_note" target="di_a"/>
    <xmi:Extension extender="FSM Editor">
      <style element="note" color="#0090ff"/>
      <style element="init" color="#30a46c"/>
      <style element="a" color="#E5484D" entry="#0090ff" exit="#8e4ec6" doActivity="#30a46c" deferrable="#a18072" invariant="#d6409f"/>
      <style element="b" bogus="#000000" exit="red" entry="#F76B15"/>
      <style element="ch" color="#8e4ec6"/>
      <style effect="#3e63dd" guard="#f76b15" triggers="#e5484d" color="#12a594" element="t2"/>
      <style element="t3" color="#d6409f"/>
      <style element="t4" triggers="#5b5bd6"/>
      <style element="t5" color="#8b8d98"/>
      <style element="missing" color="#ffffff"/>
      <style element="t6" color="#12345"/>
    </xmi:Extension>
    <xmi:Extension extender="Other Tool">
      <style element="t6" color="#000000"/>
    </xmi:Extension>
  </umldi:UMLStateMachineDiagram>
</xmi:XMI>
