<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:umldi="http://www.omg.org/spec/UML/20161101/UMLDI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <uml:Model xmi:id="m1_model" name="Structure">
    <packagedElement xmi:type="uml:StateMachine" xmi:id="m1" name="Structure">
      <connectionPoint xmi:type="uml:Pseudostate" xmi:id="mp" kind="entryPoint"/>
      <connectionPoint xmi:type="uml:Pseudostate" xmi:id="mx" name="out" kind="exitPoint"/>
      <region xmi:type="uml:Region" xmi:id="r">
        <ownedComment xmi:type="uml:Comment" xmi:id="note" annotatedElement="s1 t1 gone">
          <body>hello
world</body>
        </ownedComment>
        <subvertex xmi:type="uml:Pseudostate" xmi:id="i1" kind="initial"/>
        <subvertex xmi:type="uml:Pseudostate" xmi:id="i2" kind="initial"/>
        <subvertex xmi:type="uml:Pseudostate" xmi:id="h" kind="shallowHistory"/>
        <subvertex xmi:type="uml:State" xmi:id="s1" name="S">
          <connectionPoint xmi:type="uml:Pseudostate" xmi:id="ep" kind="entryPoint"/>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="s2" name="S">
          <connection xmi:type="uml:ConnectionPointReference" xmi:id="ref">
            <entry href="#"/>
          </connection>
        </subvertex>
        <subvertex xmi:type="uml:State" xmi:id="comp" name="Comp">
          <connectionPoint xmi:type="uml:Pseudostate" xmi:id="xp" kind="exitPoint"/>
          <region xmi:type="uml:Region" xmi:id="cr1" name="upper">
            <subvertex xmi:type="uml:State" xmi:id="in1" name="In1"/>
          </region>
          <region xmi:type="uml:Region" xmi:id="cr2">
            <subvertex xmi:type="uml:State" xmi:id="in2" name="In2"/>
          </region>
        </subvertex>
        <subvertex xmi:type="uml:Pseudostate" xmi:id="f" kind="fork"/>
        <subvertex xmi:type="uml:Pseudostate" xmi:id="j" kind="join"/>
        <subvertex xmi:type="uml:FinalState" xmi:id="fin"/>
        <subvertex xmi:type="uml:Pseudostate" xmi:id="term" kind="terminate"/>
        <subvertex xmi:type="uml:Pseudostate" xmi:id="j2" kind="junction"/>
        <subvertex xmi:type="uml:State" xmi:id="s1" name="Dup">
          <connectionPoint xmi:type="uml:Pseudostate" xmi:id="ep" kind="entryPoint"/>
        </subvertex>
        <transition xmi:type="uml:Transition" xmi:id="t1" kind="external" source="i1" target="s1">
          <guard xmi:type="uml:Constraint" xmi:id="t1_guard">
            <specification xmi:type="uml:OpaqueExpression" xmi:id="t1_guard_spec">
              <language>FSM</language>
              <body>g()</body>
            </specification>
          </guard>
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="t2" kind="external" source="i2" target="s2"/>
        <transition xmi:type="uml:Transition" xmi:id="t3" kind="external" source="s1" target="comp"/>
        <transition xmi:type="uml:Transition" xmi:id="t4" kind="external" source="s1" target="s2"/>
        <transition xmi:type="uml:Transition" xmi:id="t5" kind="external" source="fin" target="s1"/>
        <transition xmi:type="uml:Transition" xmi:id="t6" kind="external" source="f" target="in1">
          <guard xmi:type="uml:Constraint" xmi:id="t6_guard">
            <specification xmi:type="uml:OpaqueExpression" xmi:id="t6_guard_spec">
              <language>FSM</language>
              <body>x()</body>
            </specification>
          </guard>
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="t7" kind="external" source="j" target="s1"/>
        <transition xmi:type="uml:Transition" xmi:id="t8" kind="external" source="in1" target="j">
          <trigger xmi:type="uml:Trigger" xmi:id="t8_trigger1" name="e" event="ev_e"/>
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="t9" kind="internal" source="s2" target="s2">
          <trigger xmi:type="uml:Trigger" xmi:id="t9_trigger1" name="tick" event="ev_tick"/>
          <effect xmi:type="uml:OpaqueBehavior" xmi:id="t9_effect">
            <language>FSM</language>
            <body>count()</body>
          </effect>
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="t10" kind="internal" source="s1" target="s2"/>
        <transition xmi:type="uml:Transition" xmi:id="t11" kind="local" source="s1" target="s2"/>
        <transition xmi:type="uml:Transition" xmi:id="t12" kind="local" source="comp" target="in2"/>
        <transition xmi:type="uml:Transition" xmi:id="t13" kind="external" source="ep" target="s2"/>
        <transition xmi:type="uml:Transition" xmi:id="t14" kind="external" source="xp" target="in1"/>
        <transition xmi:type="uml:Transition" xmi:id="t15" kind="external" source="mx" target="s1"/>
        <transition xmi:type="uml:Transition" xmi:id="t16" kind="external" source="s2" target="ref"/>
        <transition xmi:type="uml:Transition" xmi:id="t17" kind="external" source="note" target="s1"/>
        <transition xmi:type="uml:Transition" xmi:id="t18" kind="external" source="j2" target="nope"/>
        <transition xmi:type="uml:Transition" xmi:id="t1" kind="external" source="s1" target="s1"/>
        <transition xmi:type="uml:Transition" xmi:id="t19" kind="external" source="term" target="s1">
          <trigger xmi:type="uml:Trigger" xmi:id="t19_trigger1" name="after(1s)" event="ev_after_1s_"/>
        </transition>
        <transition xmi:type="uml:Transition" xmi:id="t20" kind="external" source="h" target="s1"/>
        <transition xmi:type="uml:Transition" xmi:id="t21" kind="external" source="h" target="s2"/>
      </region>
    </packagedElement>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_e" name="e" signal="sig_e"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_e" name="e"/>
    <packagedElement xmi:type="uml:SignalEvent" xmi:id="ev_tick" name="tick" signal="sig_tick"/>
    <packagedElement xmi:type="uml:Signal" xmi:id="sig_tick" name="tick"/>
    <packagedElement xmi:type="uml:TimeEvent" xmi:id="ev_after_1s_" name="after(1s)" isRelative="true">
      <when xmi:type="uml:TimeExpression" xmi:id="ev_after_1s__when">
        <expr xmi:type="uml:LiteralString" xmi:id="ev_after_1s__expr" value="1s"/>
      </when>
    </packagedElement>
  </uml:Model>
  <umldi:UMLStateMachineDiagram xmi:id="m1_diagram" name="Structure" modelElement="m1" isFrame="false">
